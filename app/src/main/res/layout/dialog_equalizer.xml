<?xml version="1.0" encoding="utf-8"?>
<!-- Диалог 6-полосного эквалайзера: пресеты + полосы + сброс -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_eq_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/eq_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equalizer_title"
        android:textColor="?attr/paletteAccent"
        android:textSize="@dimen/settings_title_size"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/folderSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/sound_bind_folder"
        android:textColor="?attr/paletteTextPrimary"
        android:textSize="@dimen/settings_label_size" />

    <!-- Пресеты -->
    <LinearLayout
        android:id="@+id/presetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_row_spacing"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFlat"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_flat"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRock"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_rock"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMetal"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_metal"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPop"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_pop"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipJazz"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_jazz"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipClassical"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_classical"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBass"
            style="@style/Widget.Material3.Chip.Filter"
            android:checkable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/preset_bass"
            android:textSize="@dimen/eq_preset_text_size"
            app:chipStrokeColor="?attr/paletteAccent"
            app:chipStrokeWidth="@dimen/settings_field_border"
            android:layout_marginHorizontal="@dimen/eq_chip_gap" />
    </LinearLayout>

    <!-- 6 вертикальных полос: 60 / 175 / 400 / 1k / 3.5k / 12k.
         Веса: колонки поровну заполняют ширину окна — никакой обрезки крайних -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_row_spacing"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <include
            android:id="@+id/band1"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/band2"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/band3"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/band4"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/band5"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/band6"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/band7"
            layout="@layout/item_equalizer_band"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Сброс -->
    <TextView
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/settings_row_spacing"
        android:padding="@dimen/space_12"
        android:text="@string/eq_reset"
        android:textColor="?attr/paletteAccent"
        android:textSize="@dimen/settings_control_size"
        android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
