<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/settings_padding"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="?attr/paletteAccent"
            android:textSize="@dimen/settings_title_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_row_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/settings_label_width"
                android:layout_height="wrap_content"
                android:text="@string/settings_decoder"
                android:textColor="?attr/paletteTextSecondary"
                android:textSize="@dimen/settings_label_size" />

            <Spinner
                android:id="@+id/decoder"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/settings_field_height"
                android:spinnerMode="dropdown"
                android:popupBackground="?attr/palettePanel"
                android:backgroundTint="?attr/paletteAccent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_row_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/settings_label_width"
                android:layout_height="wrap_content"
                android:text="@string/settings_panels"
                android:textColor="?attr/paletteTextSecondary"
                android:textSize="@dimen/settings_label_size" />

            <Spinner
                android:id="@+id/panels"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/settings_field_height"
                android:spinnerMode="dropdown"
                android:popupBackground="?attr/palettePanel"
                android:backgroundTint="?attr/paletteAccent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_row_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/settings_label_width"
                android:layout_height="wrap_content"
                android:text="@string/settings_palette"
                android:textColor="?attr/paletteTextSecondary"
                android:textSize="@dimen/settings_label_size" />

            <Spinner
                android:id="@+id/palette"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/settings_field_height"
                android:spinnerMode="dropdown"
                android:popupBackground="?attr/palettePanel"
                android:backgroundTint="?attr/paletteAccent" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_field_border"
            android:layout_marginTop="@dimen/settings_row_spacing"
            android:background="?attr/paletteBtnBorder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/settings_equalizer_group"
            android:textColor="?attr/paletteTextPrimary"
            android:textSize="@dimen/settings_label_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearVolumeSounds"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/settings_field_height"
                android:text="@string/sound_delete_on_volume"
                android:textColor="?attr/paletteTextPrimary"
                android:textSize="@dimen/settings_label_size"
                app:cornerRadius="@dimen/settings_field_radius"
                app:strokeColor="?attr/paletteBtnBorder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearFolderSounds"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_weight="1"
                android:minHeight="@dimen/settings_field_height"
                android:text="@string/sound_delete_all"
                android:textColor="?attr/paletteTextPrimary"
                android:textSize="@dimen/settings_label_size"
                app:cornerRadius="@dimen/settings_field_radius"
                app:strokeColor="?attr/paletteBtnBorder" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_field_border"
            android:layout_marginTop="@dimen/settings_row_spacing"
            android:background="?attr/paletteBtnBorder" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/settings_library_group"
            android:textColor="?attr/paletteTextPrimary"
            android:textSize="@dimen/settings_label_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/settings_field_height"
                android:text="@string/settings_refresh"
                android:textColor="?attr/paletteTextPrimary"
                android:textSize="@dimen/settings_label_size"
                app:cornerRadius="@dimen/settings_field_radius"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconSize="@dimen/settings_action_icon_size"
                app:iconTint="?attr/paletteAccent"
                app:strokeColor="?attr/paletteBtnBorder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/savedVolumes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_weight="1"
                android:minHeight="@dimen/settings_field_height"
                android:text="@string/settings_clear_volume"
                android:textColor="?attr/paletteTextPrimary"
                android:textSize="@dimen/settings_label_size"
                app:cornerRadius="@dimen/settings_field_radius"
                app:strokeColor="?attr/paletteBtnBorder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_row_spacing"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cancel"
                android:textSize="@dimen/settings_control_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/apply"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_field_spacing"
                android:text="@string/settings_apply"
                android:textSize="@dimen/settings_control_size" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
