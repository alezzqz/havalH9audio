<?xml version="1.0" encoding="utf-8"?>
<!-- Обложка по умолчанию: градиент + нота по центру -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#101010"
                android:startColor="#232323" />
        </shape>
    </item>
    <item
        android:bottom="80dp"
        android:drawable="@drawable/ic_note_cover"
        android:gravity="center"
        android:left="80dp"
        android:right="80dp"
        android:top="80dp" />
</layer-list>