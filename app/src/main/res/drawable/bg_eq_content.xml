<?xml version="1.0" encoding="utf-8"?>
<!-- Контент диалога эквалайзера: панель с окантовкой 1dp btn_border,
     как у неактивных кнопок. Контур на 1dp отступлен от границ контента
     (оставляет под собой только панель), скругление 34dp на 3dp строже
     клипа окна (bg_eq_window, 37dp), чтобы decor не растушёвывал контур
     в углах. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/palettePanel" />
            <stroke
                android:width="1dp"
                android:color="?attr/paletteBtnBorder" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>